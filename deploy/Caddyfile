# Run the built TanStack Start server on :3000 and Fastify on :3333.
# Use a real domain; Caddy provisions HTTPS automatically.
example.com {
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Cross-Origin-Resource-Policy "same-origin"
    Permissions-Policy "microphone=(self), camera=(), geolocation=()"
    Cross-Origin-Opener-Policy "same-origin"
    X-Frame-Options "DENY"
    # Web emits one strict CSP with a fresh request nonce for TanStack's
    # streamed bootstrap script. Reverse proxy must forward it unchanged:
    # adding a second static CSP would reject that nonce.
  }

  @pwa path /sw.js /manifest.webmanifest /offline.html
  header @pwa Cache-Control "no-cache"

  # Only assets under Vite's hashed /assets/ directory get immutable cache
  # headers. This deliberately excludes /sw.js, which must revalidate.
  @hashed path_regexp hashed ^/assets/[^/]+\.(js|css|png|svg|ttf|woff2)$
  header @hashed Cache-Control "public, max-age=31536000, immutable"

  @static-assets path /icons/* /fonts/*
  header @static-assets Cache-Control "public, max-age=31536000, immutable"

  handle /api/* {
    # Fastify accepts up to MAX_UPLOAD_BYTES (25 MiB by default). The proxy
    # limits the entire multipart body, so leave room for multipart overhead.
    request_body {
      max_size 30MiB
    }
    reverse_proxy 127.0.0.1:3333 {
      transport http {
        # AI processing can legally exceed 180s; allow up to 420s for the
        # upstream response headers and request/response I/O.
        response_header_timeout 420s
        read_timeout 420s
        write_timeout 420s
      }
    }
  }
  handle /realtime/* {
    reverse_proxy 127.0.0.1:3001
  }
  handle {
    reverse_proxy 127.0.0.1:3000
  }
}
