{
  "name": "kotoba-loop",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun install",
    "dev": "bun --filter @kotoba/web dev",
    "dev:api": "bun --filter @kotoba/api dev",
    "dev:all": "bun run dev:api & bun run dev",
    "build": "bun --filter @kotoba/contracts build && bun --filter @kotoba/web build && bun --filter @kotoba/api build",
    "build:dev": "bun --filter @kotoba/web build:dev",
    "build:web": "bun --filter @kotoba/web build",
    "start:web": "bun --filter @kotoba/web start",
    "build:api": "bun --filter @kotoba/api build",
    "lint": "eslint .",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "test:integration": "bun --filter @kotoba/api test:integration",
    "format": "prettier --write README.md package.json docker-compose.yml \"apps/**/*.{ts,tsx,json,md,yml,yaml}\" \"packages/**/*.{ts,tsx,json,md,yml,yaml}\"",
    "db:migrate": "bun --filter @kotoba/api db:migrate",
    "db:seed": "bun --filter @kotoba/api db:seed",
    "storage:cleanup": "bun --filter @kotoba/api storage:cleanup",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
