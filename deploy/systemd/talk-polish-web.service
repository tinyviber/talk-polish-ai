[Unit]
Description=Talk Polish web
After=network-online.target
Wants=network-online.target
Requires=talk-polish-infra.service
After=talk-polish-infra.service

[Service]
Type=simple
User=kotoba-web
WorkingDirectory=/opt/kotoba/current/apps/web
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/local/bin/bun /opt/kotoba/current/apps/web/.output/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
