# Web build mode: demo keeps the deterministic browser-only flow; api uses Fastify + Postgres.
VITE_APP_MODE=demo
VITE_API_URL=http://localhost:3333

# API
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://kotoba:kotoba@localhost:5432/kotoba
# Development-only default. Production must use: openssl rand -base64 32
ANON_TOKEN_SECRET=local-development-anon-token-secret
# Optional personal sync token SHA-256 hex digest. Never put raw token here.
# Generate: printf '%s' '<random-token>' | sha256sum
SYNC_API_TOKEN_HASH=
ANON_TOKEN_TTL_SEC=86400
DATA_DIR=./data
AUDIO_STORAGE_DRIVER=local
TRANSCRIPTION_PROVIDER=mock
ASSESSMENT_PROVIDER=mock
TTS_PROVIDER=mock
MAX_UPLOAD_BYTES=26214400

# OpenAI-compatible providers. Keep all keys server-side; never use VITE_* here.
# Each capability can point at a different service and model.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
CHAT_TIMEOUT_MS=30000
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_TIMEOUT_MS=60000
# json | verbose_json — set json for servers without verbose transcription support.
TRANSCRIPTION_RESPONSE_FORMAT=verbose_json
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy
TTS_TIMEOUT_MS=30000
HTTP_MAX_ATTEMPTS=3
PROVIDER_RATE_LIMIT_PER_MINUTE=20
# Only for local networks that resolve public provider hosts to 198.18.0.0/15.
DAILY_PROVIDER_ALLOW_SYNTHETIC_DNS=false
# Production browser-supplied provider origins. Keep this finite and explicit.
# The DashScope workspace origin is included by the API schema default.
# DAILY_PROVIDER_ALLOWED_ORIGINS=https://api.deepseek.com,https://api.siliconflow.cn,https://ws-1ojsn1omateq5fkp.cn-beijing.maas.aliyuncs.com

# MinIO defaults for API running on host. Use http://minio:9000 inside Compose.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=kotoba-audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_REQUEST_TIMEOUT_MS=10000
S3_MAX_ATTEMPTS=3
S3_MAX_OBJECT_BYTES=26214400
S3_KEY_PREFIX=

# Realtime is deliberately experimental and disabled by default.
REALTIME_FEATURE_ENABLED=false
REALTIME_URL=
REALTIME_API_KEY=
REALTIME_PROTOCOL=websocket
REALTIME_MODEL=
REALTIME_TIMEOUT_MS=15000
DIAGNOSTICS_ACTIVE_PROBE=false
